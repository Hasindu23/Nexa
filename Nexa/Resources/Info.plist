<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
<key>CFBundleDisplayName</key><string>$(PRODUCT_NAME)</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>0.6.0</string>
<key>CFBundleVersion</key><string>10</string>
<key>LSMinimumSystemVersion</key><string>$(MACOSX_DEPLOYMENT_TARGET)</string>
<key>LSUIElement</key><true/>
<key>NSPrincipalClass</key><string>NSApplication</string>
<key>NSHighResolutionCapable</key><true/>
<key>NSHumanReadableCopyright</key><string>Copyright © 2026 Nexa contributors. MIT License.</string>
<key>NSAppleEventsUsageDescription</key><string>Nexa reads and controls Music and Spotify when you connect Now Playing, and opens a Calendar event when you click it.</string>
<key>NSCalendarsFullAccessUsageDescription</key><string>Nexa shows your upcoming events locally in the notch. Your calendar is never uploaded.</string>
<key>NSRemindersFullAccessUsageDescription</key><string>Nexa shows, creates and completes reminders when you choose to connect Reminders.</string>
<key>NSBluetoothAlwaysUsageDescription</key><string>Nexa shows paired Bluetooth accessory connection status when you enable Bluetooth.</string>
<key>NSBluetoothPeripheralUsageDescription</key><string>Nexa displays Bluetooth accessory connection status.</string>
<key>NSCameraUsageDescription</key><string>Nexa shows a live camera mirror only when you click Mirror. Nothing is recorded or uploaded.</string>
<key>NSCameraUseContinuityCameraDeviceType</key><true/>
</dict></plist>
